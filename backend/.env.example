# Gemini
GOOGLE_API_KEY=
GEMINI_GENERATION_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# External OIDC/JWT provider. The API does not issue local tokens.
OIDC_ISSUER_URL=
OIDC_JWKS_URL=
OIDC_AUDIENCE=
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_ROLE_CLAIM=roles
OIDC_REVIEWER_ROLE=reviewer

# Tavily search
TAVILY_API_KEY=
TAVILY_MCP_URL=https://mcp.tavily.com/mcp/
TAVILY_SEARCH_DEPTH=basic

# Persistence
SQLITE_PATH=backend/database/sqllite.db
CHROMA_PERSIST_DIRECTORY=backend/database/chroma
CHROMA_COLLECTION_NAME=rag_chunks

# Runtime
CORS_ORIGINS=http://localhost:3000
DEFAULT_TOP_K=6
MAX_RETRIES=3
RETRY_DELAY_SECONDS=2
TEMPERATURE=0.2
